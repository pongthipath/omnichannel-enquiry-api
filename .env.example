# Copy to .env — values work with docker-compose as-is
NODE_ENV=development
APP_ENV=local
PORT=4000
TRUST_PROXY=1
WEB_ORIGIN=http://localhost:8081

DB_HOST=postgres
DB_PORT=5432
DB_NAME=omni
DB_USER=omni
DB_PASSWORD=omni_dev_password
DB_SSL=false

REDIS_URL=redis://redis:6379
RMQ_USER=omni
RMQ_PASSWORD=omni_dev_password
RMQ_URL=amqp://omni:omni_dev_password@rabbitmq:5672

S3_ENDPOINT=http://minio:9000
S3_BUCKET=omni-attachments
S3_REGION=ap-southeast-1
S3_ACCESS_KEY=omni_minio
S3_SECRET_KEY=omni_minio_password

JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
LINE_CHANNEL_SECRET=dev-line-secret
FB_APP_SECRET=dev-fb-secret
SMTP_URL=smtp://mailpit:1025
