# Copy to .env — values target services started by docker compose, reached from the host (npm run start:dev).
# Containers (api/worker/migrate in docker-compose) override the hostnames below automatically.
NODE_ENV=development
APP_ENV=local
PORT=4000
TRUST_PROXY=1
WEB_ORIGIN=http://localhost:8081

DB_HOST=localhost
DB_PORT=5432
DB_NAME=omni
DB_USER=omni
DB_PASSWORD=omni_dev_password
DB_SSL=false

REDIS_URL=redis://localhost:6379
RMQ_USER=omni
RMQ_PASSWORD=omni_dev_password
RMQ_URL=amqp://omni:omni_dev_password@localhost:5672

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=omni-attachments
S3_REGION=ap-southeast-1
S3_ACCESS_KEY=omni_minio
S3_SECRET_KEY=omni_minio_password

JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
LINE_CHANNEL_SECRET=dev-line-secret
FB_APP_SECRET=dev-fb-secret
SMTP_URL=smtp://localhost:1025
